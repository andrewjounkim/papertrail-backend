# --- LLM (OpenAI API) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- NCBI E-utilities (PubMed) ---
# Both are optional but recommended: NCBI asks every tool to identify itself,
# and an API key raises the rate limit from 3 req/s to 10 req/s.
NCBI_API_KEY=
NCBI_EMAIL=your-email@example.com
NCBI_TOOL_NAME=papertrail

# --- CORS ---
# Comma-separated list of allowed origins for the frontend.
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5500,http://127.0.0.1:5500

# --- Server ---
# Render sets PORT automatically; used for local runs too.
PORT=5000
